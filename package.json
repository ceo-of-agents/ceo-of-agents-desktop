{
  "name": "ceo-of-agents-app",
  "productName": "CEO of Agents",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "description": "Desktop app to run a ceo-of-agents micro-org through the user's own Claude Code",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package:mac": "node scripts/package-mac.mjs",
    "icon": "node scripts/render-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "check": "npm run lint && npm test",
    "shots": "node scripts/shots/shoot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "lucide-react": "^1.74.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^45.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
